"Run_KQL_Query": {
    "type": "ApiConnection",
    "inputs": {
        "host": {
            "connection": {
                "name": "@parameters('$connections')['azuremonitorlogs']['connectionId']"
            }
        },
        "method": "post",
        "path": "/query",
        "body": {
            "query": "let targetAccount = '@{items('For_each_Account_Entity')?['AccountName']}';\nlet szOperationNames = dynamic([\"Microsoft.Compute/virtualMachines/write\", \"Microsoft.Resources/deployments/write\", \"Microsoft.Resources/subscriptions/resourceGroups/write\"]);\nlet starttime = 30d;\nlet endtime = 0d;\nlet RareCaller = union AzureActivity\n| where TimeGenerated between (ago(starttime) .. ago(endtime))\n| where OperationNameValue in~ (szOperationNames)\n| summarize count() by CallerIpAddress, Caller, OperationNameValue, bin(TimeGenerated,1d)\n| join kind=rightantisemi (\nunion AzureActivity\n| where TimeGenerated > ago(endtime)\n| where Caller has targetAccount\n| where OperationNameValue in~ (szOperationNames)\n| summarize StartTimeUtc = min(TimeGenerated), EndTimeUtc = max(TimeGenerated), ResourceIds = make_set(_ResourceId, 100) by CallerIpAddress, Caller, OperationNameValue) on CallerIpAddress, Caller, OperationNameValue;\nRareCaller\n| extend Name = iif(Caller has '@@',tostring(split(Caller,'@@',0)[0]),\"\")\n| project CallerIpAddress, Name, Caller, OperationNameValue, StartTimeUtc, ResourceIds",
            "timespan": "P30D"
        },
        "queries": {
            "resourcegroups": "@triggerBody()?['object']?['properties']?['workspaceInfo']?['ResourceGroup']",
            "resourcename": "@split(triggerBody()?['object']?['id'], '/')[8]",
            "resourcetype": "Microsoft.OperationalInsights/workspaces",
            "subscriptionId": "@triggerBody()?['object']?['properties']?['workspaceInfo']?['SubscriptionId']"
        }
    },
    "runAfter": {}
}
