// We wrap the Logic App variable in single quotes '...' so KQL reads it as a string
let IncidentTime = datetime('@{triggerBody()?['object']?['properties']?['lastModifiedTimeUtc']}');
AzureActivity
// Look 4 hours before/after the incident to ensure we catch the log
| where TimeGenerated between ((IncidentTime - 4h) .. (IncidentTime + 4h))
// Get the most recent action
| top 1 by TimeGenerated desc
// Parse the name logic
| extend Name = iif(Caller has '@',tostring(split(Caller,'@',0)[0]),"")
| extend UPNSuffix = iif(Caller has '@',tostring(split(Caller,'@',1)[0]),"")
| extend AadUserId = iif(Caller !has '@',Caller,"")
| project Name, Caller, UPNSuffix, AadUserId, CallerIpAddress, ResourceId=_ResourceId
