{
    "definition": {
        "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
        "actions": {
            "For_each_Account_Entity": {
                "type": "Foreach",
                "foreach": "@body('Entities_-_Get_Accounts')?['Accounts']",
                "actions": {
                    "Run_KQL_Query": {
                        "type": "ApiConnection",
                        "inputs": {
                            "body": {
                                "query": "let targetAccount = '@{items('For_each_Account_Entity')?['AccountName']}';\nlet szOperationNames = dynamic([\"Microsoft.Compute/virtualMachines/write\", \"Microsoft.Resources/deployments/write\", \"Microsoft.Resources/subscriptions/resourceGroups/write\"]);\nlet starttime = 14d;\nlet endtime = 1d;\nlet RareCaller = union AzureActivity\n| where TimeGenerated between (ago(starttime) .. ago(endtime))\n| where OperationNameValue in~ (szOperationNames)\n| summarize count() by CallerIpAddress, Caller, OperationNameValue, bin(TimeGenerated,1d)\n| join kind=rightantisemi (\nunion AzureActivity\n| where TimeGenerated > ago(endtime)\n| where Caller has targetAccount\n| where OperationNameValue in~ (szOperationNames)\n| summarize StartTimeUtc = min(TimeGenerated), EndTimeUtc = max(TimeGenerated), ActivityTimeStamp = make_set(TimeGenerated,100), ActivityStatusValue = make_set(ActivityStatusValue,100), CorrelationIds = make_set(CorrelationId,100), ResourceGroups = make_set(ResourceGroup,100), ResourceIds = make_set(_ResourceId,100), ActivityCountByCallerIPAddress = count()\nby CallerIpAddress, Caller, OperationNameValue) on CallerIpAddress, Caller, OperationNameValue;\nRareCaller\n| extend Name = iif(Caller has '@',tostring(split(Caller,'@',0)[0]),\"\")\n| extend UPNSuffix = iif(Caller has '@',tostring(split(Caller,'@',1)[0]),\"\")\n| extend AadUserId = iif(Caller !has '@',Caller,\"\")\n| project CallerIpAddress, Name, Caller, OperationNameValue, StartTimeUtc, EndTimeUtc, ResourceIds",
                                "timespan": "P14D"
                            },
                            "host": {
                                "connection": {
                                    "name": "@parameters('$connections')['azuremonitorlogs']['connectionId']"
                                }
                            },
                            "method": "post",
                            "path": "/query"
                        },
                        "runAfter": {}
                    },
                    "Check_If_Results_Found": {
                        "type": "If",
                        "expression": {
                            "greater": [
                                "@length(body('Run_KQL_Query')?['value'])",
                                0
                            ]
                        },
                        "actions": {
                            "Create_HTML_Table": {
                                "type": "Table",
                                "inputs": {
                                    "format": "HTML",
                                    "from": "@body('Run_KQL_Query')?['value']",
                                    "columns": [
                                        { "header": "IP Address", "value": "@item()?['CallerIpAddress']" },
                                        { "header": "User", "value": "@item()?['Name']" },
                                        { "header": "Operation", "value": "@item()?['OperationNameValue']" },
                                        { "header": "Time (UTC)", "value": "@item()?['StartTimeUtc']" },
                                        { "header": "Resources", "value": "@item()?['ResourceIds']" }
                                    ]
                                },
                                "runAfter": {}
                            },
                            "Add_Comment_Table": {
                                "type": "ApiConnection",
                                "inputs": {
                                    "body": {
                                        "comment": "📊 **Automated Analysis Result**\n\nRare activity detected based on 14-day baseline:\n\n@{body('Create_HTML_Table')}\n\n*Sending verification request to user...*"
                                    },
                                    "host": {
                                        "connection": {
                                            "name": "@parameters('$connections')['azuresentinel']['connectionId']"
                                        }
                                    },
                                    "method": "post",
                                    "path": "/Incidents/@{encodeURIComponent(triggerBody()?['object']?['properties']?['incidentNumber'])}/Comments"
                                },
                                "runAfter": {
                                    "Create_HTML_Table": [ "Succeeded" ]
                                }
                            },
                            "Post_Card_To_User": {
                                "type": "ApiConnectionWebhook",
                                "inputs": {
                                    "body": {
                                        "type": "AdaptiveCard",
                                        "body": [
                                            { "type": "TextBlock", "size": "Medium", "weight": "Bolder", "text": "Security Verification Request" },
                                            { "type": "TextBlock", "text": "Hi @{body('Run_KQL_Query')?['value']?[0]?['Name']},", "wrap": true },
                                            { "type": "TextBlock", "text": "Our security system detected rare activity on your account. Please confirm if this was you.", "wrap": true },
                                            {
                                                "type": "FactSet",
                                                "facts": [
                                                    { "title": "Operation:", "value": "@{body('Run_KQL_Query')?['value']?[0]?['OperationNameValue']}" },
                                                    { "title": "IP Address:", "value": "@{body('Run_KQL_Query')?['value']?[0]?['CallerIpAddress']}" },
                                                    { "title": "Time (UTC):", "value": "@{body('Run_KQL_Query')?['value']?[0]?['StartTimeUtc']}" }
                                                ]
                                            },
                                            { "type": "TextBlock", "text": "Was this you?", "weight": "Bolder" }
                                        ],
                                        "actions": [
                                            { "type": "Action.Submit", "title": "✅ Yes, I did this", "data": { "resp": "yes" } },
                                            { "type": "Action.Submit", "title": "❌ No, NOT me", "data": { "resp": "no" } }
                                        ],
                                        "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
                                        "version": "1.4"
                                    },
                                    "host": {
                                        "connection": {
                                            "name": "@parameters('$connections')['teams']['connectionId']"
                                        }
                                    },
                                    "path": "/v1.0/teams/conversation/member/users/@{encodeURIComponent(items('For_each_Account_Entity')?['AccountName'])}/adaptivecard/action"
                                },
                                "runAfter": {
                                    "Add_Comment_Table": [ "Succeeded" ]
                                }
                            },
                            "Compose_Response": {
                                "type": "Compose",
                                "inputs": "@body('Post_Card_To_User')?['data']?['resp']",
                                "runAfter": {
                                    "Post_Card_To_User": [ "Succeeded" ]
                                }
                            },
                            "Check_User_Response": {
                                "type": "If",
                                "expression": {
                                    "equals": [ "@outputs('Compose_Response')", "yes" ]
                                },
                                "actions": {
                                    "Comment_BAU": {
                                        "type": "ApiConnection",
                                        "inputs": {
                                            "body": {
                                                "comment": "✅ **User Confirmed**\n\nThe user confirmed this was BAU activity via Teams."
                                            },
                                            "host": {
                                                "connection": {
                                                    "name": "@parameters('$connections')['azuresentinel']['connectionId']"
                                                }
                                            },
                                            "method": "post",
                                            "path": "/Incidents/@{encodeURIComponent(triggerBody()?['object']?['properties']?['incidentNumber'])}/Comments"
                                        }
                                    }
                                },
                                "else": {
                                    "actions": {
                                        "Comment_Denied": {
                                            "type": "ApiConnection",
                                            "inputs": {
                                                "body": {
                                                    "comment": "🚨 **USER DENIED ACTIVITY**\n\nThe user explicitly stated \"No, Not Me\".\nAction: Escalating to SOC."
                                                },
                                                "host": {
                                                    "connection": {
                                                        "name": "@parameters('$connections')['azuresentinel']['connectionId']"
                                                    }
                                                },
                                                "method": "post",
                                                "path": "/Incidents/@{encodeURIComponent(triggerBody()?['object']?['properties']?['incidentNumber'])}/Comments"
                                            }
                                        },
                                        "Post_Escalation": {
                                            "type": "ApiConnection",
                                            "inputs": {
                                                "body": {
                                                    "body": {
                                                        "content": "🚨 **CRITICAL: User Denied Activity**\n\n**Incident:** #@{triggerBody()?['object']?['properties']?['incidentNumber']}\n**User:** @{body('Run_KQL_Query')?['value']?[0]?['Name']} (@{body('Run_KQL_Query')?['value']?[0]?['Caller']})\n\nThe user denied performing the operation: **@{body('Run_KQL_Query')?['value']?[0]?['OperationNameValue']}**.\n\n**Action Required:**\n1. Review the Incident.\n2. Isolate the account immediately."
                                                    }
                                                },
                                                "host": {
                                                    "connection": {
                                                        "name": "@parameters('$connections')['teams']['connectionId']"
                                                    }
                                                },
                                                "method": "post",
                                                "path": "/v3/beta/teams/YOUR_SOC_CHANNEL_ID/channels/YOUR_SOC_CHANNEL_ID/messages"
                                            },
                                            "runAfter": {
                                                "Comment_Denied": [ "Succeeded" ]
                                            }
                                        },
                                        "Add_Task_Checklist": {
                                            "type": "ApiConnection",
                                            "inputs": {
                                                "body": {
                                                    "title": "Investigate User Denied Activity",
                                                    "description": "<p><strong>User denied this activity via Teams.</strong><br>Checklist:<br>1. Check Sign-in Logs for foreign IPs.<br>2. Confirm Resource naming convention.<br>3. Reset User Password.</p>",
                                                    "status": "New"
                                                },
                                                "host": {
                                                    "connection": {
                                                        "name": "@parameters('$connections')['azuresentinel']['connectionId']"
                                                    }
                                                },
                                                "method": "post",
                                                "path": "/Incidents/@{encodeURIComponent(triggerBody()?['object']?['id'])}/tasks"
                                            },
                                            "runAfter": {
                                                "Post_Escalation": [ "Succeeded" ]
                                            }
                                        }
                                    }
                                },
                                "runAfter": {
                                    "Compose_Response": [ "Succeeded" ]
                                }
                            }
                        },
                        "runAfter": {
                            "Run_KQL_Query": [ "Succeeded" ]
                        }
                    }
                },
                "runAfter": {
                    "Entities_-_Get_Accounts": [ "Succeeded" ]
                }
            },
            "Entities_-_Get_Accounts": {
                "type": "ApiConnection",
                "inputs": {
                    "body": "@triggerBody()?['object']?['properties']?['relatedEntities']",
                    "host": {
                        "connection": {
                            "name": "@parameters('$connections')['azuresentinel']['connectionId']"
                        }
                    },
                    "method": "post",
                    "path": "/entities/account"
                },
                "runAfter": {}
            }
        },
        "contentVersion": "1.0.0.0",
        "outputs": {},
        "parameters": {
            "$connections": {
                "defaultValue": {},
                "type": "Object"
            }
        },
        "triggers": {
            "Microsoft_Sentinel_incident": {
                "type": "ApiConnectionWebhook",
                "inputs": {
                    "body": {
                        "callback_url": "@{listCallbackUrl()}"
                    },
                    "host": {
                        "connection": {
                            "name": "@parameters('$connections')['azuresentinel']['connectionId']"
                        }
                    },
                    "path": "/incident-creation-trigger"
                }
            }
        }
    },
    "parameters": {
        "$connections": {
            "value": {
                "azuresentinel": {
                    "connectionId": "/subscriptions/YOUR_SUB/resourceGroups/YOUR_RG/providers/Microsoft.Web/connections/azuresentinel",
                    "connectionName": "azuresentinel",
                    "id": "/subscriptions/YOUR_SUB/providers/Microsoft.Web/locations/YOUR_REGION/managedApis/azuresentinel"
                },
                "azuremonitorlogs": {
                    "connectionId": "/subscriptions/YOUR_SUB/resourceGroups/YOUR_RG/providers/Microsoft.Web/connections/azuremonitorlogs",
                    "connectionName": "azuremonitorlogs",
                    "id": "/subscriptions/YOUR_SUB/providers/Microsoft.Web/locations/YOUR_REGION/managedApis/azuremonitorlogs"
                },
                "teams": {
                    "connectionId": "/subscriptions/YOUR_SUB/resourceGroups/YOUR_RG/providers/Microsoft.Web/connections/teams",
                    "connectionName": "teams",
                    "id": "/subscriptions/YOUR_SUB/providers/Microsoft.Web/locations/YOUR_REGION/managedApis/teams"
                }
            }
        }
    }
}
